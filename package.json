{
  "name": "scrobble-books-data",
  "type": "module",
  "private": true,
  "packageManager": "bun@1.4.4",
  "workspaces": [
    "packages/*",
    "apps/*",
    "!apps/scrape-deno",
    "!apps/scrape-ng",
    "!apps/scrape-browser"
  ],
  "scripts": {
    "test": "bun test --pass-with-no-tests --timeout 60000",
    "check": "tsc --noEmit",
    "fmt": "prettier --write .",
    "fmt:check": "prettier --check .",
    "lint": "bun run lint:js && bun run lint:md",
    "lint:js": "eslint .",
    "lint:md": "markdownlint-cli2 \"**/*.md\"",
    "cue": "cd cue && cue vet check-goodreads.cue goodreads-example.json",
    "ci": "bun run fmt:check && bun run lint && bun run check && bun run test && bun run cue",
    "outdated": "bun outdated -r",
    "outdated:fix": "bun update -i -r",
    "act:unit": "act -j unit --container-architecture linux/amd64",
    "git:log": "echo 'Recent Scraping Commits'; git log | grep 'Latest book data' | cut -c22-31 | uniq -c | head -n 10; echo 'git pull?'",
    "browser:install": "bun apps/scrape/node_modules/playwright/cli.js install chromium",
    "cron": "bun apps/scrape/src/cron.ts",
    "login": "bun apps/scrape/src/login.ts",
    "scrape": "bun --env-file=secrets/GOODREADS.env --env-file=secrets/S3.env apps/scrape/src/scrape.ts",
    "publish": "bun run scrape --publish"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/bun": "1.4.4",
    "@types/yargs": "17.0.35",
    "eslint": "10.15.0",
    "markdownlint": "0.42.1",
    "markdownlint-cli2": "0.24.1",
    "prettier": "3.10.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.73.0"
  },
  "prettier": {
    "proseWrap": "always"
  }
}
