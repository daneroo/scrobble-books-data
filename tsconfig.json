{
  "compilerOptions": {
    // Environment setup & latest features
    "lib": ["ESNext"],
    "target": "ESNext",
    "module": "Preserve",
    "moduleDetection": "force",
    "allowJs": true,
    "types": ["bun"],

    // Bundler mode
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "noEmit": true,

    // Best practices
    "strict": true,
    "skipLibCheck": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,

    // Some stricter flags (disabled by default)
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "noPropertyAccessFromIndexSignature": false
  },
  // The old scrapers are read-only references (deno, and bun apps outside the
  // workspace, so their deps aren't installed): not part of the gate.
  // (node_modules must be restated: "exclude" replaces the default list.)
  "exclude": [
    "node_modules",
    "data",
    "apps/scrape-deno",
    "apps/scrape-ng",
    "apps/scrape-browser"
  ]
}
